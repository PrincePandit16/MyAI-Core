# LLM Configuration
LLM_MODE=http_tgi
TGI_ENDPOINT=http://host.docker.internal:8080/generate
LLAMA_BINARY_PATH=/usr/local/bin/llama-cli
LLAMA_MODEL_PATH=/models/model.gguf
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_NEW_TOKENS=256

# Database
DATABASE_URL=postgresql+psycopg://assistant:change-me@postgres:5432/assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=replace-with-a-random-32-byte-secret
POSTGRES_DB=assistant
JWT_SECRET_KEY=replace-with-a-random-32-byte-secret
COOKIE_SECURE=true
MINIO_ACCESS_KEY=replace-with-random-minio-user
MINIO_SECRET_KEY=replace-with-a-random-32-byte-secret
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-secret

# Vector Store (Milvus)
MILVUS_URI=http://milvus-standalone:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=documents

# Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Frontend
API_PROXY_TARGET=http://backend:8000
