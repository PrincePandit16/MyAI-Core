# LLM Configuration
LLM_MODE=http_tgi
TGI_ENDPOINT=http://host.docker.internal:8080/generate
LLAMA_BINARY_PATH=/usr/local/bin/llama-cli
LLAMA_MODEL_PATH=/models/model.gguf
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_NEW_TOKENS=256

# Database
DATABASE_URL=postgresql+psycopg://assistant:assistant@postgres:5432/assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant

# Vector Store (Milvus)
MILVUS_URI=http://milvus-standalone:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=documents

# Embedding Model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Frontend
API_PROXY_TARGET=http://backend:8000
