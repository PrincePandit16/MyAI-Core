# Select "http_tgi", "local_llama", or the existing "groq" provider.
LLM_MODE=http_tgi

# TGI HTTP endpoint. For direct backend development on the host:
TGI_ENDPOINT=http://localhost:8080/generate

# llama.cpp settings (used when LLM_MODE=local_llama).
LLAMA_BINARY_PATH=./llama-cli
LLAMA_MODEL_PATH=./models/model.gguf

# Shared generation timeout and TGI retry count.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_NEW_TOKENS=256
